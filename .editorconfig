root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

# Disabled: this rule requires the right-hand side of *any* multi-line
# assignment or expression-body function (`val x = Foo(\n ... \n)`,
# `fun f() = runTest { ... }`) to be pushed onto its own line after the
# `=`. That's a far more aggressive interpretation than the project
# anticipated — it would touch a large fraction of the codebase,
# including constructor-call-heavy test files and production code alike,
# for a purely cosmetic formatting preference. A few already-flagged
# files were fixed by hand; this stops the same rule from blocking on
# every other file that happens to share the same (extremely common)
# Kotlin shape.
ktlint_standard_multiline-expression-wrapping = disabled
