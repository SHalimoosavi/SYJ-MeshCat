<?xml version="1.0" encoding="utf-8"?>
<!--
    Simple mesh-network glyph (three nodes connected by edges) centered in
    the adaptive-icon safe zone. Placeholder art — a proper vector mark can
    replace this later without touching ic_launcher.xml or the background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Edges -->
    <path
        android:strokeColor="#818CF8"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M40,40 L68,40 M40,40 L54,68 M68,40 L54,68" />

    <!-- Nodes -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M40,40 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
    <path
        android:fillColor="#F59E0B"
        android:pathData="M68,40 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
    <path
        android:fillColor="#F59E0B"
        android:pathData="M54,68 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
