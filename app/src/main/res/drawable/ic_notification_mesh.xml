<?xml version="1.0" encoding="utf-8"?>
<!-- Status bar icons must be a simple white silhouette on transparent — the
     system applies its own tinting, so color here is just a safe default.
     Three-node mesh glyph, matching the launcher icon's visual language. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Edges -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M8,8 L16,8 M8,8 L12,16 M16,8 L12,16" />

    <!-- Nodes -->
    <path android:fillColor="#FF000000" android:pathData="M8,8 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    <path android:fillColor="#FF000000" android:pathData="M16,8 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    <path android:fillColor="#FF000000" android:pathData="M12,16 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
</vector>
